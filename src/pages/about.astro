---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const aboutPage = pages.find(p => p.id === 'about');
const { Content } = aboutPage ? await render(aboutPage) : { Content: null };
---

<BaseLayout title="关于">
  <article class="about-page">
    <div class="content">
      {Content ? <Content /> : <p>关于页面内容未找到。</p>}
    </div>
  </article>
</BaseLayout>

<style>
  .about-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .content {
    line-height: 1.8;
  }

  .content :global(h1) {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .content :global(ul) {
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }
</style>
