---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout title="首页">
  <section class="hero">
    <div class="hero-mascot">
      <Mascot size={120} />
    </div>
    <h1>欢迎来到我的博客</h1>
    <p class="subtitle">探索技术，分享见解</p>
    <p class="hero-desc">
      这里是我分享技术见解、学习心得和项目经验的地方。
      专注于前端开发、后端技术和工具效率。
    </p>
  </section>

  <section class="latest-posts">
    <div class="section-header">
      <h2>最新文章</h2>
      <a href="/blog" class="section-link">查看全部 &rarr;</a>
    </div>
    <div class="posts-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="blog-card card">
          <article>
            <time class="card-date">{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
            <h3 class="card-title">{post.data.title}</h3>
            <p class="card-desc">{post.data.description}</p>
            {post.data.tags?.length > 0 && (
              <div class="card-tags">
                {post.data.tags.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </article>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4rem;
  }

  .hero-mascot {
    margin-bottom: 2.5rem;
    opacity: 0.9;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    font-weight: 450;
    margin-bottom: 1.5rem;
    letter-spacing: 0.01em;
  }

  .hero-desc {
    max-width: 560px;
    margin: 0 auto;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.8;
  }

  .latest-posts {
    padding: 0 0 4rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .section-link:hover {
    color: var(--accent);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
  }

  .blog-card {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem;
  }

  .card-date {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .blog-card:hover .card-title {
    color: var(--accent);
  }

  .card-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: 0.75rem;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .blog-card:hover .tag {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 0 2rem;
    }

    .hero-mascot :global(svg) {
      width: 100px;
      height: auto;
    }

    .section-header {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
